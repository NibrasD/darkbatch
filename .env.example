# Reference only: the application does not auto-load this file.
# Set these variables in the local shell/process environment. Never commit a real .env file.

# Local coordinator / trusted settlement agent
DARKBATCH_API_BASE=http://127.0.0.1:8000
DARKBATCH_COORDINATOR_API_BASE=http://127.0.0.1:8000
DARKBATCH_SETTLEMENT_TOKEN=
DARKBATCH_ALLOW_SIMULATION=false
DARKBATCH_SOLVER_FEE_RECEIVER_RAW_HEX=

# Local synced Zebra Testnet RPC
ZCASH_TESTNET_RPC_URL=http://127.0.0.1:18232
ZCASH_TESTNET_RPC_USER=
ZCASH_TESTNET_RPC_PASS=

# EVM network and canonical DarkBatchQuoteEscrow deployment
DARKBATCH_QUOTE_RPC_URL=
DARKBATCH_QUOTE_CHAIN_ID=
DARKBATCH_QUOTE_DEPLOYMENT_BLOCK=
DARKBATCH_USDC_TOKEN_ADDRESS=
DARKBATCH_USDC_ESCROW_ADDRESS=

# Confirmation policy: code requires a minimum of two; values below two are rejected.
DARKBATCH_MINIMUM_ZEC_CONFIRMATIONS=2
DARKBATCH_MINIMUM_FINALIZATION_CONFIRMATIONS=2
DARKBATCH_QUOTE_MIN_CONFIRMATIONS=2

# Secrets used only by local operator scripts. Leave empty until configured securely.
DARKBATCH_QUOTE_ORACLE_PRIVATE_KEY=
DARKBATCH_QUOTE_COORDINATOR_PRIVATE_KEY=
DARKBATCH_BUYER_PRIVATE_KEY=

# Optional transaction/batch operations
DARKBATCH_USDC_BATCH_ID=
DARKBATCH_USDC_BATCH_DEADLINE_SECONDS=1800
DARKBATCH_EPOCH_ID=
DARKBATCH_ZEC_TXID=
DARKBATCH_RELEASE_STATE_PATH=
DARKBATCH_REFUND_STATE_PATH=
DARKBATCH_USDC_REFUND_GRACE_SECONDS=86400
